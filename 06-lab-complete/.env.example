# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  rồi sửa (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Secret — tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis (rate limit + cost guard dùng chung)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD). Bỏ trống MONTHLY_BUDGET_USD = không giới hạn theo tháng
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10

# Giá USD / 1K token (mặc định gpt-4o-mini) — đổi model / tự định giá thì sửa ở đây
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006
